{
  "name": "vertragsuebersicht",
  "version": "0.2.0",
  "private": true,
  "description": "Vertragsübersicht – Desktop-App für die Versicherungsagentur",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "screenshots": "node werkzeug/screenshots.mjs",
    "installer": "electron-vite build && electron-builder --win nsis --publish never",
    "installer:mac": "electron-vite build && electron-builder --mac --publish never",
    "veroeffentlichen": "electron-vite build && electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@azure/msal-node": "^7.1.2",
    "@cantoo/pdf-lib": "^2.11.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "electron-updater": "^6.8.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yjs": "^13.6.33"
  },
  "main": "out/main/index.js",
  "author": "Versicherungsagentur"
}
